# Runtime mode
TIKTOK_UPLOAD_MODE=dry_run
PUBLIC_BASE_URL=https://your-domain.example
TIKTOK_REDIRECT_URI=https://your-domain.example/api/tiktok/callback
TIKTOK_N8N_WEBHOOK_URL=

# API protection — generate long random values in production
API_AUTH_TOKEN=
COOKIE_UPDATE_TOKEN=
RATE_LIMIT_PER_MINUTE=60

# Auto crawl
AUTO_CRAWL_SCHEDULER_ENABLED=false
AUTO_CRAWL_INTERVAL_MINUTES=60
AUTO_CRAWL_CHANNELS_PER_BATCH=20
AUTO_CRAWL_MAX_VIDEOS_PER_CHANNEL=20
AUTO_CRAWL_MAX_VIDEO_AGE_HOURS=72
AUTO_CRAWL_MIN_VIEW_COUNT=0
AUTO_CRAWL_MIN_LIKE_COUNT=0
AUTO_CRAWL_MAX_CHANNEL_RETRIES=3
AUTO_CRAWL_DOWNLOAD_NEW=true

# Translation provider
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=your-model-name
AGENTROUTER_CLIENT_USER_AGENT=your-app-name

# Optional direct paths/overrides
DOWNLOAD_DIR=./download
AUTO_CRAWL_DB_PATH=./douyin_crawl_data/autocrawl.db
DOUYIN_COOKIE_FILE=./secrets/douyin_cookie.txt
AGENTROUTER_API_KEY_FILE=./secrets/agentrouter_api_key.txt
TIKTOK_OAUTH_CONFIG_FILE=./secrets/tiktok_dev_oauth.json
TIKTOK_UPLOAD_DATA_DIR=./tiktok_upload_data
SECRETS_DIR=./secrets
